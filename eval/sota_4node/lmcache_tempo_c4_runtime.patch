+
+def _uses_nixl_libfabric_cxi(config: LMCacheEngineConfig) -> bool:
+    """Return whether transfer-channel initialization uses CXI via NIXL."""
+    if str(config.transfer_channel).strip().lower() != "nixl":
+        return False
+    backends = config.nixl_backends or []
+    if isinstance(backends, str):
+        backends = [backends]
+    if "LIBFABRIC" not in {str(backend).strip().upper() for backend in backends}:
+        return False
+    return os.getenv("FI_PROVIDER", "").strip().lower() == "cxi"
+
+
+@contextmanager
+def _serialize_nixl_libfabric_cxi_initialization(config: LMCacheEngineConfig):
+    """Serialize node-local CXI setup across tensor-parallel workers.
+
+    Cray libfabric can stall in CUDA memory registration when several worker
+    processes concurrently create CXI rails, progress threads, and memory
+    regions. The lock deliberately covers the complete transfer-channel
+    constructor, not only ``fi_mr_reg``. It is released before serving any
+    request, so the data-transfer hot path is unaffected.
+    """
+    if not _uses_nixl_libfabric_cxi(config):
+        yield
+        return
+
+    lock_path = os.getenv(
+        _NIXL_CXI_INIT_LOCK_PATH_ENV,
+        f"/tmp/lmcache-nixl-libfabric-cxi-init-{os.getuid()}.lock",
+    )
+    lock_fd = os.open(lock_path, os.O_CREAT | os.O_CLOEXEC | os.O_RDWR, 0o600)
+    locked = False
+    try:
+        logger.info("Waiting for node-local NIXL LIBFABRIC/CXI initialization lock")
+        fcntl.flock(lock_fd, fcntl.LOCK_EX)
+        locked = True
+        logger.info("Acquired node-local NIXL LIBFABRIC/CXI initialization lock")
+        yield
+    finally:
+        if locked:
+            fcntl.flock(lock_fd, fcntl.LOCK_UN)
+        os.close(lock_fd)
+
 

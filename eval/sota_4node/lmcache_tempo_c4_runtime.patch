+"""Snapshotting revision of the exact-signature TEMPO NIXL hot path."""
+
+from __future__ import annotations
+
+from dataclasses import asdict
+import hashlib
+import inspect
+import json
+import os
+from pathlib import Path
+import threading
+import time
+from typing import Any
+
+from lmcache.v1.transfer_channel import tempo_nixl_hotpath as v1
+
+
+SCHEMA = "tempo-lmcache-nixl-hotpath-2"
+
+
+def _payload(state: Any) -> dict[str, Any]:
+    with state.lock:
+        return {
+            "schema": SCHEMA,
+            "pid": os.getpid(),
+            "implementation": "exact-signature-prepared-cache-adaptive-progress-snapshot",
+            "configuration": {
+                "cache_capacity": v1._strict_int_env("TEMPO_NIXL_CACHE_CAPACITY", 128, 0, 4096),
+                "yield_polls": v1._strict_int_env("TEMPO_NIXL_YIELD_POLLS", 16, 0, 4096),
+                "sleep_us": v1._strict_int_env("TEMPO_NIXL_SLEEP_US", 100, 1, 1000000),
+            },
+            "stats": asdict(state.stats),
+            "idle_handles_at_snapshot": state.idle_count,
+            "inflight_handles_at_snapshot": len(state.inflight),
+            "closed_at_snapshot": state.closed,
+            "source": {
+                "stock_async_batched_write_sha256": v1.EXPECTED_ASYNC_WRITE_SHA256,
+                "stock_close_sha256": v1.EXPECTED_CLOSE_SHA256,
+            },
+        }
+
+
+def _snapshot(state: Any) -> None:
+    directory = os.environ.get("TEMPO_LMCACHE_NIXL_STATS_DIR")
+    if not directory:
+        return
+    root = Path(directory)
+    root.mkdir(parents=True, exist_ok=True)
+    target = root / f"nixl-hotpath-{os.getpid()}-{id(state):x}.json"
+    temporary = root / (
+        f".{target.name}.{threading.get_ident()}.{time.perf_counter_ns()}.tmp"
+    )
+    descriptor = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
+    try:
+        with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
+            json.dump(_payload(state), handle, sort_keys=True, separators=(",", ":"))
+            handle.write("\n")
+        os.replace(temporary, target)
+    finally:
+        if temporary.exists():
+            temporary.unlink()
+
+
+def install(channel_class: type[Any]) -> None:
+    if getattr(channel_class, "_tempo_nixl_hotpath_v2_installed", False):
+        return
+    original_async = channel_class.async_batched_write
+    original_close = channel_class.close
+    async_hash = hashlib.sha256(inspect.getsource(original_async).encode()).hexdigest()
+    close_hash = hashlib.sha256(inspect.getsource(original_close).encode()).hexdigest()
+    if async_hash != v1.EXPECTED_ASYNC_WRITE_SHA256 or close_hash != v1.EXPECTED_CLOSE_SHA256:
+        raise RuntimeError("LMCache NixlChannel source drifted; refusing TEMPO v2 installation")
+
+    async def patched_async(self: Any, objects: list[Any], transfer_spec=None) -> int:
+        try:
+            return await v1.async_batched_write(self, objects, transfer_spec)
+        finally:
+            state = getattr(self, "_tempo_nixl_hotpath_state", None)
+            if state is not None:
+                _snapshot(state)
+
+    def patched_close(self: Any) -> None:
+        state = getattr(self, "_tempo_nixl_hotpath_state", None)
+        if state is not None:
+            with state.lock:
+                state.closed = True
+                idle = [item for bucket in state.idle.values() for item in bucket]
+                state.idle.clear()
+                state.idle_count = 0
+            for handle in idle:
+                self.nixl_agent.release_xfer_handle(handle)
+                with state.lock:
+                    state.stats.release_count += 1
+            _snapshot(state)
+        original_close(self)
+
+    channel_class.async_batched_write = patched_async
+    channel_class.close = patched_close
+    channel_class._tempo_nixl_hotpath_v2_installed = True
+    channel_class._tempo_nixl_hotpath_original_async = original_async
+    channel_class._tempo_nixl_hotpath_original_close = original_close

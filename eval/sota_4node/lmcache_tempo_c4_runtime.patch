new file mode 100644
index 0000000..91ffd8a
--- /dev/null
+++ b/lmcache/v1/transfer_channel/tempo_nixl_hotpath.py
@@ -0,0 +1,245 @@
+"""Opt-in TEMPO hot path for LMCache's asynchronous NIXL writes.
+
+Prepared handles are reused only after DONE and only for an exact descriptor
+signature. Stock LMCache remains unchanged unless explicitly enabled.
+"""
+
+from __future__ import annotations
+
+import asyncio
+from collections import defaultdict
+from dataclasses import asdict, dataclass, field
+import hashlib
+import inspect
+import json
+import os
+from pathlib import Path
+import threading
+import time
+from typing import Any
+
+
+SCHEMA = "tempo-lmcache-nixl-hotpath-1"
+EXPECTED_ASYNC_WRITE_SHA256 = "c45d2e35e340422a2c0241baf58d50c5c395e1103a42d60ca5cce848dd785b3e"
+EXPECTED_CLOSE_SHA256 = "a4b7e0a90f2df83b5910665a28a2b7aa08d8288c9c4f97e267e1e925bf0b996c"
+
+
+@dataclass
+class _Stats:
+    make_count: int = 0
+    reuse_count: int = 0
+    release_count: int = 0
+    error_count: int = 0
+    transfer_count: int = 0
+    object_count: int = 0
+    yield_poll_count: int = 0
+    sleep_poll_count: int = 0
+    immediate_done_count: int = 0
+    cache_high_watermark: int = 0
+    elapsed_ns: list[int] = field(default_factory=list)
+
+
+class _ChannelState:
+    def __init__(self) -> None:
+        self.lock = threading.Lock()
+        self.idle: dict[tuple[Any, ...], list[Any]] = defaultdict(list)
+        self.idle_count = 0
+        self.inflight: dict[int, Any] = {}
+        self.stats = _Stats()
+        self.closed = False
+
+
+def _strict_int_env(name: str, default: int, minimum: int, maximum: int) -> int:
+    raw = os.environ.get(name, str(default))
+    try:
+        value = int(raw)
+    except ValueError as error:
+        raise RuntimeError(f"{name} must be an integer") from error
+    if not minimum <= value <= maximum:
+        raise RuntimeError(f"{name} must be in [{minimum}, {maximum}]")
+    return value
+
+
+def _state(channel: Any) -> _ChannelState:
+    state = getattr(channel, "_tempo_nixl_hotpath_state", None)
+    if state is None:
+        state = _ChannelState()
+        channel._tempo_nixl_hotpath_state = state
+    return state
+
+
+def _key(channel: Any, objects: list[Any], transfer_spec: dict[str, Any]) -> tuple[Any, ...]:
+    receiver_id = transfer_spec.get("receiver_id")
+    remote_indexes = transfer_spec.get("remote_indexes")
+    if not isinstance(receiver_id, str) or not receiver_id:
+        raise RuntimeError("TEMPO NIXL write requires a nonempty receiver_id")
+    if not isinstance(remote_indexes, list) or not remote_indexes:
+        raise RuntimeError("TEMPO NIXL write requires nonempty remote_indexes")
+    if any(type(index) is not int or index < 0 for index in remote_indexes):
+        raise RuntimeError("TEMPO NIXL remote indexes must be nonnegative integers")
+    local = channel.get_local_mem_indices(objects)
+    if len(local) != len(remote_indexes):
+        raise RuntimeError("TEMPO NIXL local/remote descriptor count mismatch")
+    remote_handler = channel.remote_xfer_handlers_dict[receiver_id]
+    return (
+        receiver_id,
+        id(channel.nixl_wrapper.xfer_handler),
+        id(remote_handler),
+        tuple(local),
+        tuple(remote_indexes),
+    )
+
+
+def _take_handle(channel: Any, state: _ChannelState, key: tuple[Any, ...]) -> Any:
+    with state.lock:
+        if state.closed:
+            raise RuntimeError("TEMPO NIXL channel is closed")
+        bucket = state.idle.get(key)
+        if bucket:
+            handle = bucket.pop()
+            state.idle_count -= 1
+            if not bucket:
+                state.idle.pop(key, None)
+            state.stats.reuse_count += 1
+        else:
+            receiver_id, _, _, local, remote = key
+            handle = channel.nixl_agent.make_prepped_xfer(
+                "WRITE",
+                channel.nixl_wrapper.xfer_handler,
+                list(local),
+                channel.remote_xfer_handlers_dict[receiver_id],
+                list(remote),
+            )
+            state.stats.make_count += 1
+        state.inflight[id(handle)] = handle
+        return handle
+
+
+def _finish_handle(channel: Any, state: _ChannelState, key: tuple[Any, ...], handle: Any, *, reusable: bool) -> None:
+    capacity = _strict_int_env("TEMPO_NIXL_CACHE_CAPACITY", 128, 0, 4096)
+    release = False
+    with state.lock:
+        state.inflight.pop(id(handle), None)
+        if reusable and not state.closed and state.idle_count < capacity:
+            state.idle[key].append(handle)
+            state.idle_count += 1
+            state.stats.cache_high_watermark = max(state.stats.cache_high_watermark, state.idle_count)
+        else:
+            release = True
+    if release:
+        channel.nixl_agent.release_xfer_handle(handle)
+        with state.lock:
+            state.stats.release_count += 1
+
+
+async def async_batched_write(channel: Any, objects: list[Any], transfer_spec: dict[str, Any] | None = None) -> int:
+    if not objects:
+        raise RuntimeError("TEMPO NIXL write requires at least one object")
+    if not isinstance(transfer_spec, dict):
+        raise RuntimeError("TEMPO NIXL write requires a transfer specification")
+    state = _state(channel)
+    key = _key(channel, objects, transfer_spec)
+    handle = _take_handle(channel, state, key)
+    yield_budget = _strict_int_env("TEMPO_NIXL_YIELD_POLLS", 16, 0, 4096)
+    sleep_us = _strict_int_env("TEMPO_NIXL_SLEEP_US", 100, 1, 1000000)
+    started_ns = time.perf_counter_ns()
+    reusable = False
+    polls = 0
+    try:
+        channel.nixl_agent.transfer(handle)
+        while True:
+            status = channel.nixl_agent.check_xfer_state(handle)
+            if status == "DONE":
+                reusable = True
+                break
+            if status == "ERR":

+void test_prepared_phase_delta_expires_unused_and_skips_do_not_carry() {
+    tempo_credit_controller_t controller;
+    assert(controller.install_credit_plan(
+        1, 0, MiB, 0, 16 * MiB, 500000000ULL
+    ));
+    controller.mark_d2h_queued(2 * MiB);
+    controller.mark_d2h_ready(2 * MiB);
+
+    // Phase 0 is intentionally unused.  Phase 2's cumulative ceiling grows
+    // by exactly one MiB, so only that delta may become active.
+    assert(controller.prepare_credit_transition(
+        10, 1, 2, 2 * MiB, 0, 16 * MiB, 500000000ULL
+    ));

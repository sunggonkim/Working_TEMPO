+void test_dynamic_d2h_grants_and_phase_local_prefix_deltas() {
+    tempo_credit_controller_t controller;
+    const std::uint64_t odd = 123;
+    const std::uint64_t total = 3 * MiB + 333;
+    assert(controller.install_credit_plan(
+        1, 0, MiB + odd, 0, 16 * MiB, 500000000ULL
+    ));
+    controller.mark_d2h_queued(total);
+    controller.mark_d2h_ready(total);
+
+    // The engine clamps the caller's maximum to one 1 MiB request, then
+    // returns the exact odd phase remainder rather than overspending it.
+    const std::uint64_t first = controller.admit_d2h_up_to(4 * MiB);
+    assert(first == MiB);
+    controller.complete_d2h(first);
+    const std::uint64_t odd_tail = controller.admit_d2h_up_to(MiB);
+    assert(odd_tail == odd);
+    controller.complete_d2h(odd_tail);
+
+    std::atomic<bool> next_admitted {false};
+    std::uint64_t next_grant = 0;
+    std::thread waiter([&] {
+        next_grant = controller.admit_d2h_up_to(MiB);
+        next_admitted.store(true, std::memory_order_release);
+    });
+    std::this_thread::sleep_for(std::chrono::milliseconds(20));
+    assert(!next_admitted.load(std::memory_order_acquire));
+
+    // Skip phase 1.  Phase 2 transports a cumulative prefix but activates
+    // only its increment over phase 0; the worker rebases that increment to
+    // the actual admitted total at the phase transition.
+    assert(controller.install_credit_plan(
+        1, 2, 2 * MiB + 333, 0, 16 * MiB, 500000000ULL
+    ));
+    waiter.join();
+    assert(next_grant == MiB);
+    controller.complete_d2h(next_grant);
+    const std::uint64_t second_odd_tail = controller.admit_d2h_up_to(MiB);
+    assert(second_odd_tail == 210);
+    controller.complete_d2h(second_odd_tail);
+
+    // A new plan version captures a new base and may start from a smaller
+    // cumulative ceiling without losing already completed bytes.
+    assert(controller.install_credit_plan(
+        2, 0, MiB, 0, 16 * MiB, 500000000ULL
+    ));
+    const std::uint64_t final = controller.admit_d2h_up_to(MiB);
+    assert(final == MiB);
+    controller.complete_d2h(final);
+
+    const std::string stats = controller.get_stage_stats();
+    assert(contains(stats, "\"max_d2h_request_bytes\":1048576"));
+    assert(contains(stats, "\"d2h_phase_admitted_bytes\":1048576"));
+    assert(contains(stats, "\"max_request_bytes\":1048576"));
+    assert(contains(stats, "\"peak_inflight_bytes\":1048576"));
+    assert(contains(stats, "\"peak_inflight_requests\":1"));
+    assert(contains(stats, "\"inflight_requests\":0"));
+    assert(contains(stats, "\"invariant_violation_count\":0"));
+}

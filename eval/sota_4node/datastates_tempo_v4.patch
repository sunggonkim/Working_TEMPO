+void test_work_conserving_d2h_close_suspends_and_compute_resumes() {
+    tempo_credit_controller_t controller;
+    require(
+        controller.install_credit_plan(
+            1, 0, 3 * MiB, 0, 16 * MiB, 2000000000ULL
+        ),
+        "work-conserving carry bootstrap was rejected"
+    );
+    controller.mark_d2h_queued(4 * MiB);
+    controller.mark_d2h_ready(4 * MiB);
+
+    const std::uint64_t first = controller.admit_d2h_up_to(4 * MiB);
+    require(first == MiB, "bootstrap D2H request exceeded one MiB");
+    controller.complete_d2h(first);
+
+    // Token 80 models the boundary immediately before NCCL.  Its own fresh
+    // residual is exactly one physical qD request; the unused two-MiB compute
+    // prefix must become dormant rather than being exposed to the collective.
+    require(
+        controller.prepare_credit_transition(
+            80, 1, 1, 4 * MiB, 0, 16 * MiB, 2000000000ULL,
+            0, std::numeric_limits<std::uint64_t>::max(), false, true
+        ),
+        "work-conserving collective CLOSE was rejected"
+    );
+    // A zero-fresh compute boundary must still be able to resume the dormant
+    // prefix.  Token 82 is the terminal CLOSE and must discard no live carry
+    // after the resumed two MiB have been consumed.
+    require(
+        controller.prepare_credit_transition(
+            81, 1, 2, 4 * MiB, 0, 16 * MiB, 2000000000ULL
+        ),
+        "zero-fresh compute resume was rejected"
+    );
+    require(
+        controller.prepare_credit_transition(
+            82, 1, 3, 4 * MiB, 0, 16 * MiB, 2000000000ULL
+        ),
+        "terminal D2H CLOSE was rejected"
+    );
+    require(
+        controller.activate_prepared_credit_transition_for_test(
+            80, steady_now_ns(), 800
+        ),
+        "work-conserving collective CLOSE did not activate"
+    );
+    std::string stats = controller.get_stage_stats();
+    require(
+        contains(stats, "\"d2h_suspended_budget_bytes\":2097152"),
+        "compute remainder was not suspended at collective CLOSE"
+    );
+    require(
+        contains(stats, "\"d2h_budget_bytes\":1048576"),
+        "collective active D2H budget exceeded its fresh one-MiB residual"
+    );
+    const std::uint64_t collective = controller.admit_d2h_up_to(4 * MiB);
+    require(collective == MiB, "collective admitted more than one MiB");
+    controller.complete_d2h(collective);
+
+    std::atomic<bool> resumed {false};
+    std::uint64_t resumed_grant = 0;
+    std::thread waiter([&] {
+        resumed_grant = controller.admit_d2h_up_to(4 * MiB);
+        resumed.store(true, std::memory_order_release);
+    });
+    std::this_thread::sleep_for(std::chrono::milliseconds(20));
+    require(
+        !resumed.load(std::memory_order_acquire),
+        "collective consumed dormant compute credit"
+    );
+    require(
+        controller.activate_prepared_credit_transition_for_test(
+            81, steady_now_ns(), 801
+        ),
+        "compute resume transition did not activate"
+    );
+    waiter.join();
+    require(resumed_grant == MiB, "resumed D2H request exceeded one MiB");
+    controller.complete_d2h(resumed_grant);
+
+    // Leave one MiB of the resumed allowance unused.  The terminal boundary
+    // must expire it rather than retaining a hidden lease for the synthetic
+    // probe or the next controller plan.
+    require(
+        controller.activate_prepared_credit_transition_for_test(
+            82, steady_now_ns(), 802
+        ),
+        "terminal D2H CLOSE did not activate"
+    );
+    stats = controller.get_stage_stats();
+    require(
+        contains(stats, "\"d2h_suspended_budget_bytes\":0"),
+        "terminal CLOSE leaked suspended D2H credit"
+    );
+    require(
+        contains(stats, "\"d2h_budget_bytes\":0"),
+        "terminal CLOSE left an active D2H budget"
+    );
+    require(
+        contains(stats, "\"d2h_expired_credit_bytes\":1048576"),
+        "terminal CLOSE did not expire the unconsumed resumed allowance"
+    );
+    require(
+        contains(stats, "\"max_request_bytes\":1048576"),
+        "physical D2H request bound changed during carry"
+    );
+    require(
+        contains(stats, "\"watchdog_trip_count\":0"),
+        "carry/resume path tripped the watchdog"
+    );
+    require(
+        contains(stats, "\"force_drain\":false"),
+        "carry/resume path forced drain"
+    );
+    require(controller.retire_credit_transition_callbacks(), "carry callbacks did not retire");
+    const std::string trace = controller.take_admission_trace();
+    require(
+        contains(trace, "\"preserve_d2h_on_close\":true"),
+        "trace lacks the work-conserving D2H CLOSE flag"
+    );
+    require(
+        contains(trace, "\"d2h_carry_out_bytes\":2097152"),
+        "trace lacks the suspended compute remainder"
+    );
+    require(
+        contains(trace, "\"d2h_carry_in_bytes\":2097152"),
+        "trace lacks the resumed compute remainder"
+    );
+    require(
+        contains(trace, "\"d2h_effective_budget_bytes\":2097152"),
+        "trace lacks the effective resumed compute budget"
+    );
+}

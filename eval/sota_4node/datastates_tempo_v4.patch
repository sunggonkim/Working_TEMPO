+            out << "\"status\":\"" << transition_status_name_(status) << "\"";
+            out << '}';
+        }
+        out << "],";
+        out << "\"entries\":[";
+        bool first = true;
+        for (const admission_trace_entry_t& entry : admission_trace_) {
+            if (!first)
+                out << ',';
+            first = false;
+            out << '{';
+            out << "\"token\":" << entry.token << ',';
+            out << "\"plan_version\":" << entry.plan_version << ',';
+            out << "\"phase_id\":" << entry.phase_id << ',';
+            out << "\"stream_ordered\":" << (entry.stream_ordered ? "true" : "false") << ',';
+            out << "\"d2h_cumulative_ceiling_bytes\":"
+                << entry.d2h_cumulative_ceiling_bytes << ',';
+            out << "\"pfs_cumulative_ceiling_bytes\":"
+                << entry.pfs_cumulative_ceiling_bytes << ',';
+            out << "\"d2h_active_budget_bytes\":" << entry.d2h_active_budget_bytes << ',';
+            out << "\"pfs_active_budget_bytes\":" << entry.pfs_active_budget_bytes << ',';
+            out << "\"activation_monotonic_ns\":" << entry.activation_monotonic_ns << ',';
+            out << "\"activation_unix_ns\":" << entry.activation_unix_ns << ',';
+            out << "\"applied_monotonic_ns\":" << entry.applied_monotonic_ns << ',';
+            out << "\"not_before_monotonic_ns\":" << entry.not_before_monotonic_ns << ',';
+            out << "\"expires_monotonic_ns\":" << entry.expires_monotonic_ns << ',';
+            out << "\"d2h_base_admitted_bytes\":" << entry.d2h_base_admitted_bytes << ',';
+            out << "\"pfs_base_admitted_bytes\":" << entry.pfs_base_admitted_bytes << ',';

diff --git a/include/common/logical_file_layout.hpp b/include/common/logical_file_layout.hpp
new file mode 100644
index 0000000..0f9d1a9
--- /dev/null
+++ b/include/common/logical_file_layout.hpp
@@ -0,0 +1,108 @@
+#ifndef __DATASTATES_LOGICAL_FILE_LAYOUT_HPP
+#define __DATASTATES_LOGICAL_FILE_LAYOUT_HPP
+
+#include <cstdint>
+#include <limits>
+#include <mutex>
+#include <optional>
+#include <stdexcept>
+#include <string>
+#include <utility>
+
+#include "common/json.hpp"
+
+namespace datastates {
+
+struct logical_file_layout_t {
+    static constexpr std::uint64_t schema_version = 1;
+
+    std::uint64_t publication_sequence = 0;
+    std::uint64_t version = 0;
+    std::string path;
+    std::uint64_t payload_extent_bytes = 0;
+    std::uint64_t metadata_bytes = 0;
+    std::uint64_t logical_file_extent_bytes = 0;
+    std::uint64_t fs_block_alignment_bytes = 0;
+};
+
+// Publishes the logical serialized extent independently of physical file
+// creation or transfer progress.  A snapshot is immutable and copied while
+// holding the mutex, so a reader can never observe fields from two saves.
+class logical_file_layout_publisher_t {
+private:
+    mutable std::mutex mutex_;
+    std::uint64_t publication_sequence_ = 0;
+    std::optional<logical_file_layout_t> latest_;
+
+public:
+    logical_file_layout_t publish(
+        std::uint64_t version,
+        std::string path,
+        std::uint64_t payload_extent_bytes,
+        std::uint64_t metadata_bytes,
+        std::uint64_t fs_block_alignment_bytes
+    ) {
+        if (path.empty())
+            throw std::invalid_argument("logical checkpoint path must not be empty");
+        if (payload_extent_bytes == 0 || metadata_bytes == 0) {
+            throw std::invalid_argument(
+                "logical checkpoint payload and metadata extents must be positive"
+            );
+        }
+        if (fs_block_alignment_bytes == 0)
+            throw std::invalid_argument("filesystem block alignment must be positive");
+        if (payload_extent_bytes % fs_block_alignment_bytes != 0 ||
+            metadata_bytes % fs_block_alignment_bytes != 0) {
+            throw std::invalid_argument(
+                "logical checkpoint extents must be filesystem-block aligned"
+            );
+        }
+        if (metadata_bytes >
+            std::numeric_limits<std::uint64_t>::max() - payload_extent_bytes) {
+            throw std::overflow_error("logical checkpoint file extent overflow");
+        }
+
+        std::lock_guard<std::mutex> lock(mutex_);
+        if (publication_sequence_ == std::numeric_limits<std::uint64_t>::max())
+            throw std::overflow_error("logical checkpoint publication sequence overflow");
+
+        logical_file_layout_t next;
+        next.publication_sequence = publication_sequence_ + 1;
+        next.version = version;
+        next.path = std::move(path);
+        next.payload_extent_bytes = payload_extent_bytes;
+        next.metadata_bytes = metadata_bytes;
+        next.logical_file_extent_bytes = payload_extent_bytes + metadata_bytes;
+        next.fs_block_alignment_bytes = fs_block_alignment_bytes;
+
+        latest_ = next;
+        publication_sequence_ = next.publication_sequence;
+        return next;
+    }
+
+    logical_file_layout_t snapshot() const {
+        std::lock_guard<std::mutex> lock(mutex_);
+        // Sequence zero is an explicit unpublished sentinel.  Returning the
+        // same fixed schema before the first save lets a caller prove that one
+        // and only one fresh publication occurred during engine.save().
+        return latest_.value_or(logical_file_layout_t {});
+    }
+};
+
+inline std::string logical_file_layout_to_json(const logical_file_layout_t& layout) {
+    nlohmann::json record = {
+        {"schema_version", logical_file_layout_t::schema_version},
+        {"publication_sequence", layout.publication_sequence},
+        {"version", layout.version},
+        {"path", layout.path},
+        {"payload_extent_bytes", layout.payload_extent_bytes},
+        {"metadata_bytes", layout.metadata_bytes},
+        {"logical_file_extent_bytes", layout.logical_file_extent_bytes},
+        {"fs_block_alignment_bytes", layout.fs_block_alignment_bytes},
+    };
+    return record.dump();
+}
+
+} // namespace datastates
+
+#endif // __DATASTATES_LOGICAL_FILE_LAYOUT_HPP

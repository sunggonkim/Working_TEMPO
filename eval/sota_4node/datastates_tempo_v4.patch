+            out << "\"pfs_drain_requests\":" << entry.pfs_drain_requests;
+            out << '}';
+        }
+        out << "]}";
+        admission_trace_.clear();
+        active_trace_index_ = std::numeric_limits<std::size_t>::max();
+        for (std::uint64_t index = 0; index < prepared_count; ++index)
+            transition_state_->slots[index].reset();
+        transition_state_->prepared_count.store(0, std::memory_order_release);
+        last_applied_transition_sequence_ = 0;

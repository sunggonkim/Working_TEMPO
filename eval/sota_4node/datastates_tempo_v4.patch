+    assert(contains(stats, "\"active_transition_token\":12"));
+    assert(contains(stats, "\"d2h_budget_bytes\":1048576"));
+    const std::uint64_t second = controller.admit_d2h_up_to(MiB);
+    assert(second == MiB);
+    controller.complete_d2h(second);
+    assert(controller.retire_credit_transition_callbacks());
+    const std::string trace = controller.take_admission_trace();
+    assert(contains(trace, "\"status\":\"PREPARED_NOT_ENQUEUED\""));
+    assert(contains(trace, "\"stream_ordered\":true"));
+    assert(contains(trace, "\"d2h_expired_before_bytes\":1048576"));
+}

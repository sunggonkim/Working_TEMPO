+void test_checked_transitions_and_disable_guard() {
+    tempo_credit_controller_t checked;
+    assert(checked.install_credit_plan(1, 1, unlimited, unlimited, 16 * MiB, 500000000ULL));
+    checked.mark_d2h_ready(4096); // Deliberately omit mark_d2h_queued().
+    assert(checked.admit_d2h_up_to(4096) == 4096);
+    checked.complete_d2h(4096);
+    const std::string checked_stats = checked.get_stage_stats();
+    assert(contains(checked_stats, "\"force_drain\":true"));
+    assert(contains(checked_stats, "\"invariant_violation_count\":1"));
+    assert(contains(checked_stats, "\"queued_bytes\":0"));
+    assert(contains(checked_stats, "\"inflight_bytes\":0"));
+
+    tempo_credit_controller_t bad_completion;
+    assert(bad_completion.install_credit_plan(
+        1, 1, unlimited, unlimited, 16 * MiB, 500000000ULL
+    ));
+    bad_completion.complete_d2h(4096); // Deliberately complete without admission.
+    const std::string bad_completion_stats = bad_completion.get_stage_stats();
+    assert(contains(bad_completion_stats, "\"force_drain\":true"));
+    assert(contains(bad_completion_stats, "\"invariant_violation_count\":2"));
+
+    tempo_credit_controller_t guarded;
+    assert(guarded.install_credit_plan(1, 1, unlimited, unlimited, 16 * MiB, 500000000ULL));
+    guarded.mark_d2h_queued(4096);
+    guarded.disable_credit_control();
+    assert(guarded.is_enabled());
+    assert(guarded.is_force_drain());
+    guarded.mark_d2h_ready(4096);
+    assert(guarded.admit_d2h_up_to(4096) == 4096);
+    guarded.complete_d2h(4096);
+    guarded.disable_credit_control();
+    assert(!guarded.is_enabled());
+
+    tempo_credit_controller_t durability_guarded;
+    assert(durability_guarded.install_credit_plan(
+        1, 1, unlimited, unlimited, 16 * MiB, 500000000ULL
+    ));
+    durability_guarded.mark_pfs_queued(4096);
+    durability_guarded.mark_pfs_ready(4096);
+    assert(durability_guarded.admit_pfs_up_to(4096, 4096) == 4096);
+    durability_guarded.complete_pfs(4096);
+    durability_guarded.disable_credit_control();
+    assert(durability_guarded.is_enabled());
+    durability_guarded.mark_pfs_fsync_complete();
+    durability_guarded.disable_credit_control();
+    assert(!durability_guarded.is_enabled());
+}

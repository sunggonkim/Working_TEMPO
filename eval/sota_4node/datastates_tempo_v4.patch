+void test_exact_aligned_partial_pfs_tail() {
+    tempo_credit_controller_t controller;
+    constexpr std::uint64_t alignment = 4096;
+    constexpr std::uint64_t tail = 778240;
+    static_assert(tail == 190 * alignment);
+    require(
+        controller.install_credit_plan(1, 1, 0, tail, 16 * MiB, 500000000ULL),
+        "exact partial PFS plan was rejected"
+    );
+    controller.mark_pfs_queued(tail);
+    controller.mark_pfs_ready(tail);
+
+    // The file handler asks for a normal 4 MiB request.  A finite, fully
+    // ready final extent must return its exact filesystem-aligned suffix
+    // instead of waiting for watchdog fail-open or overspending the lease.
+    const std::uint64_t grant = controller.admit_pfs_up_to(4 * MiB, alignment);
+    require(grant == tail, "exact partial PFS grant differs from the final tail");
+    controller.complete_pfs(grant);
+
+    const std::string stats = controller.get_stage_stats();
+    require(contains(stats, "\"admitted_bytes\":778240"), "partial PFS admission is absent");
+    require(contains(stats, "\"completed_bytes\":778240"), "partial PFS completion is absent");
+    require(contains(stats, "\"inflight_bytes\":0"), "partial PFS bytes remain in flight");
+    require(contains(stats, "\"inflight_requests\":0"), "partial PFS request remains in flight");
+    require(contains(stats, "\"watchdog_trip_count\":0"), "partial PFS grant tripped watchdog");
+    require(contains(stats, "\"invariant_violation_count\":0"), "partial PFS grant violated an invariant");
+    require(contains(stats, "\"force_drain\":false"), "partial PFS grant forced drain");
+
+    const std::string trace = controller.take_admission_trace();
+    require(contains(trace, "\"pfs_bytes\":778240"), "partial PFS trace bytes differ");
+    require(contains(trace, "\"pfs_requests\":1"), "partial PFS trace request count differs");
+    require(contains(trace, "\"pfs_controlled_bytes\":778240"), "partial PFS trace is not controlled");
+    require(contains(trace, "\"pfs_drain_bytes\":0"), "partial PFS trace used drain bytes");
+}

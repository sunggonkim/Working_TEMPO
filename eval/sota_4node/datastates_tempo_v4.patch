+
+std::uint64_t clock_now_ns(clockid_t clock_id) {
+    timespec value {};
+    if (clock_gettime(clock_id, &value) != 0)
+        return 0;
+    return static_cast<std::uint64_t>(value.tv_sec) * 1000000000ULL
+        + static_cast<std::uint64_t>(value.tv_nsec);
+}
+
+} // namespace
+
+void tempo_credit_controller_t::transition_callback_(void* user_data) {
+    auto* slot = static_cast<prepared_transition_t*>(user_data);
+    transition_state_t* state = slot->owner;
+    const std::uint64_t monotonic_ns = clock_now_ns(CLOCK_MONOTONIC);
+    const std::uint64_t unix_ns = clock_now_ns(CLOCK_REALTIME);
+    activate_callback_token_(slot, monotonic_ns, unix_ns);
+    state->completed_callbacks.fetch_add(1, std::memory_order_acq_rel);
+    state->cv.notify_all();
+    const std::uint64_t exit_monotonic_ns = clock_now_ns(CLOCK_MONOTONIC);
+    slot->callback_exit_monotonic_ns.store(
+        exit_monotonic_ns, std::memory_order_release
+    );
+    slot->callback_duration_ns.store(
+        exit_monotonic_ns >= monotonic_ns ? exit_monotonic_ns - monotonic_ns : 0,
+        std::memory_order_release
+    );
+    // This decrement is deliberately the final access through user_data.  The
+    // control thread releases the preallocated state's self-hold only after a
+    // stream synchronization, pending==0, and enqueued==completed.  Keeping
+    // pending nonzero through the exit timestamp also makes the reported
+    // duration cover activation, publication, completion accounting, and the
+    // callback's notification without taking a mutex or allocating.
+    state->pending_callbacks.fetch_sub(1, std::memory_order_acq_rel);
+}
+
+bool tempo_credit_controller_t::enqueue_credit_transition(
+    std::uint64_t token,
+    std::uint64_t cuda_stream_uintptr
+) {
+    prepared_transition_t* slot = nullptr;
+    {
+        std::lock_guard<std::mutex> lock(admission_mutex_);
+        slot = find_prepared_transition_locked_(token);
+        if (slot == nullptr) {
+            invalid_plan_count_.fetch_add(1, std::memory_order_acq_rel);
+            rejected_plan_count_.fetch_add(1, std::memory_order_acq_rel);
+            record_invariant_violation_locked_();
+            transition_state_->cv.notify_all();
+            return false;
+        }
+        const transition_status_t status = static_cast<transition_status_t>(
+            slot->status.load(std::memory_order_acquire)
+        );
+        if (
+            status != transition_status_t::PREPARED
+            || force_drain_.load(std::memory_order_acquire)
+            || transition_state_->activation_blocked.load(std::memory_order_acquire)
+        ) {
+            rejected_plan_count_.fetch_add(1, std::memory_order_acq_rel);
+            record_invariant_violation_locked_();
+            transition_state_->cv.notify_all();
+            return false;
+        }
+        if (!transition_state_->callback_lifetime_hold)
+            transition_state_->callback_lifetime_hold = transition_state_;
+        slot->status.store(
+            static_cast<std::uint64_t>(transition_status_t::ENQUEUED),
+            std::memory_order_release
+        );
+        transition_state_->pending_callbacks.fetch_add(1, std::memory_order_acq_rel);
+        transition_state_->enqueued_callbacks.fetch_add(1, std::memory_order_acq_rel);
+    }
+
+    cudaStream_t stream = reinterpret_cast<cudaStream_t>(
+        static_cast<std::uintptr_t>(cuda_stream_uintptr)
+    );
+    const cudaError_t result = cudaLaunchHostFunc(
+        stream,
+        &tempo_credit_controller_t::transition_callback_,
+        slot
+    );
+    if (result == cudaSuccess)
+        return true;
+
+    {
+        std::lock_guard<std::mutex> lock(admission_mutex_);
+        slot->status.store(
+            static_cast<std::uint64_t>(transition_status_t::ENQUEUE_FAILED),
+            std::memory_order_release
+        );
+        transition_state_->enqueue_failure_count.fetch_add(1, std::memory_order_acq_rel);
+        transition_state_->completed_callbacks.fetch_add(1, std::memory_order_acq_rel);
+        transition_state_->pending_callbacks.fetch_sub(1, std::memory_order_acq_rel);
+        rejected_plan_count_.fetch_add(1, std::memory_order_acq_rel);
+        // Enqueue failure makes stream ordering unknowable for the rest of the
+        // event.  Latch irreversible DRAIN immediately.
+        record_invariant_violation_locked_();
+    }
+    transition_state_->cv.notify_all();

+        21, steady_now_ns(), 100
+    ));
+    assert(!reordered.activate_prepared_credit_transition_for_test(
+        20, steady_now_ns(), 101
+    ));
+    std::string stats = reordered.get_stage_stats();
+    assert(contains(stats, "\"active_transition_token\":21"));
+    assert(contains(stats, "\"stale_transition_callback_count\":1"));
+
+    tempo_credit_controller_t drained;
+    assert(drained.install_credit_plan(1, 0, 0, 0, 16 * MiB, 500000000ULL));
+    assert(drained.prepare_credit_transition(
+        30, 1, 1, MiB, MiB, 16 * MiB, 500000000ULL
+    ));
+    drained.force_drain();
+    assert(!drained.activate_prepared_credit_transition_for_test(
+        30, steady_now_ns(), 200
+    ));
+    stats = drained.get_stage_stats();
+    assert(contains(stats, "\"force_drain\":true"));
+    assert(contains(stats, "\"active_transition_token\":0"));
+    assert(contains(stats, "\"blocked_transition_callback_count\":1"));
+}

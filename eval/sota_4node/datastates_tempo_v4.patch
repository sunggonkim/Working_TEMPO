+void test_transition_validity_not_before_and_expiry_are_enforced() {
+    tempo_credit_controller_t controller;
+    assert(controller.install_credit_plan(1, 0, 0, 0, 16 * MiB, 500000000ULL));
+    controller.mark_d2h_queued(8192);
+    controller.mark_d2h_ready(8192);
+    const std::uint64_t now = steady_now_ns();
+    assert(controller.prepare_credit_transition(
+        40, 1, 1, 4096, 0, 16 * MiB, 500000000ULL,
+        now + 20000000ULL, now + 60000000ULL
+    ));
+    assert(controller.activate_prepared_credit_transition_for_test(40, now, 300));
+    std::atomic<bool> first_done {false};
+    std::thread first([&] {
+        const std::uint64_t grant = controller.admit_d2h_up_to(4096);
+        assert(grant == 4096);
+        controller.complete_d2h(grant);
+        first_done.store(true, std::memory_order_release);
+    });
+    std::this_thread::sleep_for(std::chrono::milliseconds(5));
+    assert(!first_done.load(std::memory_order_acquire));
+    first.join();
+
+    std::this_thread::sleep_until(
+        std::chrono::steady_clock::time_point(std::chrono::nanoseconds(now + 65000000ULL))
+    );
+    std::atomic<bool> expired_done {false};
+    std::thread expired([&] {
+        const std::uint64_t grant = controller.admit_d2h_up_to(4096);
+        assert(grant == 4096);
+        controller.complete_d2h(grant);
+        expired_done.store(true, std::memory_order_release);
+    });
+    std::this_thread::sleep_for(std::chrono::milliseconds(5));
+    assert(!expired_done.load(std::memory_order_acquire));
+    assert(controller.prepare_credit_transition(
+        41, 1, 2, 8192, 0, 16 * MiB, 500000000ULL
+    ));
+    assert(controller.activate_prepared_credit_transition_for_test(
+        41, steady_now_ns(), 301
+    ));
+    expired.join();
+}
+
+void test_stale_or_decreasing_cumulative_plan_drains() {
+    tempo_credit_controller_t stale;
+    assert(stale.install_credit_plan(1, 0, MiB, 0, 16 * MiB, 500000000ULL));
+    assert(stale.install_credit_plan(1, 2, 2 * MiB, MiB, 16 * MiB, 500000000ULL));
+    assert(!stale.install_credit_plan(1, 1, 2 * MiB, MiB, 16 * MiB, 500000000ULL));
+    assert(stale.is_force_drain());
+    assert(contains(stale.get_stage_stats(), "\"rejected_plan_count\":1"));
+
+    tempo_credit_controller_t decreasing;
+    assert(decreasing.install_credit_plan(
+        1, 0, 2 * MiB, 2 * MiB, 16 * MiB, 500000000ULL
+    ));
+    assert(!decreasing.install_credit_plan(
+        1, 3, MiB, 2 * MiB, 16 * MiB, 500000000ULL
+    ));
+    assert(decreasing.is_force_drain());
+    assert(contains(decreasing.get_stage_stats(), "\"rejected_plan_count\":1"));
+}

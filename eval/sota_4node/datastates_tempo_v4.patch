+    std::string take_admission_trace() {
+        std::lock_guard<std::mutex> lock(admission_mutex_);
+        apply_activated_transitions_locked_();
+        const std::uint64_t pending =
+            transition_state_->pending_callbacks.load(std::memory_order_acquire);
+        const std::uint64_t enqueued =
+            transition_state_->enqueued_callbacks.load(std::memory_order_acquire);
+        const std::uint64_t completed =
+            transition_state_->completed_callbacks.load(std::memory_order_acquire);
+        if (
+            pending != 0
+            || enqueued != completed
+            || transition_state_->callback_lifetime_hold
+        ) {
+            throw std::runtime_error(
+                "take_admission_trace requires synchronized and retired CUDA callbacks"
+            );
+        }
+        if (active_trace_index_ < admission_trace_.size()) {
+            auto remaining = expire_active_credit_locked_();
+            // take() observes but does not close the live budget; undo the
+            // lifetime expiry totals while retaining end-only unconsumed
+            // evidence on the final trace entry.
+            d2h_expired_credit_bytes_.fetch_sub(remaining.first, std::memory_order_acq_rel);
+            pfs_expired_credit_bytes_.fetch_sub(remaining.second, std::memory_order_acq_rel);
+        }
+        std::ostringstream out;
+        out << '{';
+        out << "\"schema_version\":\"tempo-v4-admission-trace-2\",";
+        out << "\"active_token\":"
+            << transition_state_->active_token.load(std::memory_order_acquire) << ',';
+        out << "\"enqueued_callbacks\":" << enqueued << ',';
+        out << "\"completed_callbacks\":" << completed << ',';
+        out << "\"stale_callback_count\":"
+            << transition_state_->stale_callback_count.load(std::memory_order_acquire) << ',';
+        out << "\"blocked_callback_count\":"
+            << transition_state_->blocked_callback_count.load(std::memory_order_acquire) << ',';
+        out << "\"enqueue_failure_count\":"
+            << transition_state_->enqueue_failure_count.load(std::memory_order_acquire) << ',';
+        out << "\"transitions\":[";
+        const std::uint64_t prepared_count =
+            transition_state_->prepared_count.load(std::memory_order_acquire);
+        for (std::uint64_t index = 0; index < prepared_count; ++index) {
+            if (index != 0)
+                out << ',';
+            const prepared_transition_t& slot = transition_state_->slots[index];
+            const transition_status_t status = static_cast<transition_status_t>(
+                slot.status.load(std::memory_order_acquire)
+            );
+            out << '{';
+            out << "\"token\":" << slot.token << ',';
+            out << "\"plan_version\":" << slot.plan_version << ',';
+            out << "\"phase_id\":" << slot.phase_id << ',';
+            out << "\"d2h_cumulative_ceiling_bytes\":"
+                << slot.d2h_cumulative_ceiling_bytes << ',';
+            out << "\"pfs_cumulative_ceiling_bytes\":"
+                << slot.pfs_cumulative_ceiling_bytes << ',';
+            out << "\"d2h_active_budget_bytes\":" << slot.d2h_active_budget_bytes << ',';
+            out << "\"pfs_active_budget_bytes\":" << slot.pfs_active_budget_bytes << ',';
+            out << "\"preserve_d2h_on_close\":"
+                << (slot.preserve_d2h_on_close ? "true" : "false") << ',';
+            out << "\"not_before_monotonic_ns\":" << slot.not_before_monotonic_ns << ',';
+            out << "\"expires_monotonic_ns\":" << slot.expires_monotonic_ns << ',';
+            out << "\"activation_monotonic_ns\":"
+                << slot.activation_monotonic_ns.load(std::memory_order_acquire) << ',';
+            out << "\"activation_unix_ns\":"
+                << slot.activation_unix_ns.load(std::memory_order_acquire) << ',';
+            out << "\"callback_exit_monotonic_ns\":"
+                << slot.callback_exit_monotonic_ns.load(std::memory_order_acquire) << ',';
+            out << "\"callback_duration_ns\":"

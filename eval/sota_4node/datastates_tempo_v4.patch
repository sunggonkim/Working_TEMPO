@@ -0,0 +1,163 @@
+#include "common/logical_file_layout.hpp"
+
+#include <atomic>
+#include <cstdint>
+#include <limits>
+#include <stdexcept>
+#include <string>
+#include <thread>
+#include <vector>
+
+using datastates::logical_file_layout_publisher_t;
+using datastates::logical_file_layout_to_json;
+
+namespace {
+
+void require(bool condition) {
+    if (!condition)
+        throw std::runtime_error("logical file layout test requirement failed");
+}
+
+template <typename Exception, typename Callable>
+void assert_throws(Callable&& callable) {
+    bool threw = false;
+    try {
+        callable();
+    } catch (const Exception&) {
+        threw = true;
+    }
+    require(threw);
+}
+
+void test_unpublished_and_invalid_records_are_rejected() {
+    logical_file_layout_publisher_t publisher;
+    const auto unpublished = publisher.snapshot();
+    require(unpublished.publication_sequence == 0);
+    require(unpublished.version == 0);
+    require(unpublished.path.empty());
+    require(unpublished.payload_extent_bytes == 0);
+    require(unpublished.metadata_bytes == 0);
+    require(unpublished.logical_file_extent_bytes == 0);
+    require(unpublished.fs_block_alignment_bytes == 0);
+    const auto unpublished_json = nlohmann::json::parse(
+        logical_file_layout_to_json(unpublished)
+    );
+    require(unpublished_json.size() == 8);
+    require(unpublished_json.at("schema_version") == 1);
+    require(unpublished_json.at("publication_sequence") == 0);
+    require(unpublished_json.at("path") == "");
+    assert_throws<std::invalid_argument>([&] {
+        (void) publisher.publish(7, "", 4096, 4096, 4096);
+    });
+    assert_throws<std::invalid_argument>([&] {
+        (void) publisher.publish(7, "/tmp/rank-7.ckpt", 0, 4096, 4096);
+    });
+    assert_throws<std::invalid_argument>([&] {
+        (void) publisher.publish(7, "/tmp/rank-7.ckpt", 4096, 0, 4096);
+    });
+    assert_throws<std::invalid_argument>([&] {
+        (void) publisher.publish(7, "/tmp/rank-7.ckpt", 4096, 4096, 0);
+    });
+    assert_throws<std::invalid_argument>([&] {
+        (void) publisher.publish(7, "/tmp/rank-7.ckpt", 4097, 4096, 4096);
+    });
+    assert_throws<std::invalid_argument>([&] {
+        (void) publisher.publish(7, "/tmp/rank-7.ckpt", 4096, 4097, 4096);
+    });
+    assert_throws<std::overflow_error>([&] {
+        (void) publisher.publish(
+            7,
+            "/tmp/rank-7.ckpt",
+            std::numeric_limits<std::uint64_t>::max() - 1,
+            2,
+            1
+        );
+    });
+    // Failed publications must not consume a sequence number or create a
+    // stale record that could be mistaken for the current checkpoint.
+    require(publisher.snapshot().publication_sequence == 0);
+}
+
+void test_exact_extent_schema_and_immutable_snapshots() {
+    logical_file_layout_publisher_t publisher;
+    const auto first = publisher.publish(
+        41, "/tmp/rank-0-\"quoted\".ckpt", 402706432, 24576, 4096
+    );
+    require(first.publication_sequence == 1);
+    require(first.version == 41);
+    require(first.payload_extent_bytes == 402706432);
+    require(first.metadata_bytes == 24576);
+    require(first.logical_file_extent_bytes == 402731008);
+    require(first.fs_block_alignment_bytes == 4096);
+
+    const std::string encoded = logical_file_layout_to_json(first);
+    const auto decoded = nlohmann::json::parse(encoded);
+    require(decoded.size() == 8);
+    require(decoded.at("schema_version") == 1);
+    require(decoded.at("publication_sequence") == 1);
+    require(decoded.at("version") == 41);
+    require(decoded.at("path") == "/tmp/rank-0-\"quoted\".ckpt");
+    require(decoded.at("payload_extent_bytes") == 402706432);
+    require(decoded.at("metadata_bytes") == 24576);
+    require(decoded.at("logical_file_extent_bytes") == 402731008);
+    require(decoded.at("fs_block_alignment_bytes") == 4096);
+
+    const auto second = publisher.publish(
+        42, "/tmp/rank-0-next.ckpt", 8192, 4096, 4096
+    );
+    require(second.publication_sequence == 2);
+    require(publisher.snapshot().publication_sequence == 2);
+    // Publishing a later checkpoint cannot mutate a previously returned
+    // snapshot held by a caller.
+    require(first.publication_sequence == 1);
+    require(first.version == 41);
+    require(first.logical_file_extent_bytes == 402731008);
+}
+
+void test_concurrent_publication_and_snapshot_are_not_torn() {
+    logical_file_layout_publisher_t publisher;
+    constexpr std::uint64_t publications = 128;
+    (void) publisher.publish(0, "/tmp/initial.ckpt", 4096, 4096, 4096);
+
+    std::atomic<bool> writer_done {false};
+    std::thread writer([&] {
+        for (std::uint64_t version = 1; version <= publications; ++version) {
+            (void) publisher.publish(
+                version,
+                "/tmp/checkpoint-" + std::to_string(version),
+                version * 4096,
+                4096,
+                4096
+            );
+        }
+        writer_done.store(true, std::memory_order_release);
+    });
+
+    std::uint64_t last_sequence = 0;
+    while (!writer_done.load(std::memory_order_acquire)) {
+        const auto snapshot = publisher.snapshot();
+        require(snapshot.publication_sequence >= last_sequence);
+        require(snapshot.logical_file_extent_bytes ==
+                snapshot.payload_extent_bytes + snapshot.metadata_bytes);
+        require(snapshot.payload_extent_bytes % snapshot.fs_block_alignment_bytes == 0);
+        require(snapshot.metadata_bytes % snapshot.fs_block_alignment_bytes == 0);
+        require(snapshot.logical_file_extent_bytes % snapshot.fs_block_alignment_bytes == 0);
+        require(!snapshot.path.empty());
+        last_sequence = snapshot.publication_sequence;
+    }
+    writer.join();
+
+    const auto latest = publisher.snapshot();
+    require(latest.publication_sequence == publications + 1);
+    require(latest.version == publications);
+    require(latest.logical_file_extent_bytes == publications * 4096 + 4096);
+}
+
+} // namespace
+
+int main() {
+    test_unpublished_and_invalid_records_are_rejected();
+    test_exact_extent_schema_and_immutable_snapshots();
+    test_concurrent_publication_and_snapshot_are_not_torn();
+    return 0;
+}

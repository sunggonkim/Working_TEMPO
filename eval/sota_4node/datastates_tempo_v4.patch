+            out << "\"d2h_requests\":" << entry.d2h_requests << ',';
+            out << "\"d2h_controlled_bytes\":" << entry.d2h_controlled_bytes << ',';
+            out << "\"d2h_controlled_requests\":" << entry.d2h_controlled_requests << ',';

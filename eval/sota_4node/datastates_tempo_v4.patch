+    assert(controller.install_credit_plan(
+        1, 1, unlimited, unlimited, 16 * MiB, 500000000ULL
+    ));
+    const std::uint64_t request = 4096;
+    controller.mark_pfs_queued(5 * request);
+    controller.mark_pfs_ready(5 * request);
+    for (int index = 0; index < 4; ++index)
+        assert(controller.admit_pfs_up_to(request, request) == request);
+
+    std::atomic<bool> fifth_admitted {false};
+    std::thread waiter([&] {
+        assert(controller.admit_pfs_up_to(request, request) == request);
+        fifth_admitted.store(true, std::memory_order_release);
+    });
+    std::this_thread::sleep_for(std::chrono::milliseconds(20));
+    assert(!fifth_admitted.load(std::memory_order_acquire));
+    controller.complete_pfs(request);
+    waiter.join();
+    assert(fifth_admitted.load(std::memory_order_acquire));
+
+    for (int index = 0; index < 4; ++index)
+        controller.complete_pfs(request);
+    const std::string stats = controller.get_stage_stats();
+    assert(contains(stats, "\"max_pfs_inflight_requests\":4"));
+    assert(contains(stats, "\"inflight_requests\":0"));
+    assert(contains(stats, "\"admitted_requests\":5"));
+    assert(contains(stats, "\"max_request_bytes\":4096"));
+    assert(contains(stats, "\"peak_inflight_requests\":4"));
+    assert(contains(stats, "\"invariant_violation_count\":0"));
+}

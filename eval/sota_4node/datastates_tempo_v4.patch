+        10, steady_now_ns(), 1234
+    ));
+    std::string stats = controller.get_stage_stats();
+    assert(contains(stats, "\"active_transition_token\":10"));
+    assert(contains(stats, "\"d2h_budget_bytes\":1048576"));
+    assert(contains(stats, "\"d2h_expired_credit_bytes\":1048576"));
+    const std::uint64_t admitted = controller.admit_d2h_up_to(4 * MiB);
+    assert(admitted == MiB);
+    controller.complete_d2h(admitted);
+
+    // Token 11 is prepared but never enqueued/activated.  Token 12's active
+    // allowance is still only its own one-MiB delta, not tokens 11+12.
+    assert(controller.prepare_credit_transition(
+        11, 1, 3, 3 * MiB, 0, 16 * MiB, 500000000ULL
+    ));
+    assert(controller.prepare_credit_transition(
+        12, 1, 4, 4 * MiB, 0, 16 * MiB, 500000000ULL
+    ));

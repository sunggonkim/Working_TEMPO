      },
      {
        "cache_state": "miss",
        "output_tokens": 256,
        "prompt_tokens": 2048
      },
      {
        "cache_state": "p_only",
        "output_tokens": 16,
        "prompt_tokens": 4094
      }
    ],
    "replicate_ids": [
      2,

{
  "schema": "tempo-pd-performance-contract-2",
  "claim_scope": "screen_only_actual_vllm_pd",
  "model": "models/Qwen2.5-7B-Instruct",
  "model_max_length": 8192,
  "topology": {
    "nodes": 4,
    "gpus_per_node": 4,
    "replicas": 2,
    "prefill_tensor_parallel": 4,
    "decode_tensor_parallel": 4,
    "total_gpu_budget": 16
  },
  "remote_path": {
    "connector": "LMCacheConnectorV1",
    "transfer_channel": "nixl",
    "backend": "UCX",
    "gpu_connector_v3": true,
    "chunk_size_tokens": 64
  },
  "workload": {
    "prompt_repetitions": [64, 192, 384],
    "expected_prompt_tokens_for_frozen_model": [1220, 3652, 7300],
    "output_tokens": 64,
    "samples_per_bucket": 3,
    "request_rate_per_second": 2.0,
    "max_workers": 4,
    "calibration_and_validation_prompts_distinct": true
  },
  "lifecycles": [
    "calibration_local",
    "calibration_remote",
    "validation_local",
    "validation_remote",
    "validation_tempo"
  ],
  "slo_ms": {"ttft": 1000.0, "tpot": 100.0, "e2e": 5000.0},
  "policy": {
    "classifier": "exact_closed_key",
    "minimum_samples_per_route": 3,
    "remote_advantage_margin_ms": 5.0,
    "manifest_scope": "screen_only",
    "manifest_frozen_before_validation": true
  },
  "required_outputs": [
    "workloads/workload_manifest.json",
    "policy_manifest.json",
    "policy_build_report.json",
    "validation_local/raw.json",
    "validation_remote/raw.json",
    "validation_tempo/raw.json",
    "result.json"
  ]
}

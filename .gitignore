paper/tempo_sc/*.aux
paper/tempo_sc/*.bbl
paper/tempo_sc/*.blg
paper/tempo_sc/*.fdb_latexmk
paper/tempo_sc/*.fls
paper/tempo_sc/*.log
paper/tempo_sc/*.out
paper/tempo_sc/*.pdf

# Local tooling noise.
.DS_Store
.pytest_cache/
.coverage*
htmlcov/
